# Kopier denne fil til .env og udfyld dine egne værdier

# Hemmelig nøgle til session-kryptering (generer med: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=SKIFT_DENNE_TIL_EN_LANG_TILFAELDIG_STRENG

# Google OAuth (opret på https://console.cloud.google.com)
GOOGLE_CLIENT_ID=dit-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dit-google-client-secret

# Microsoft OAuth (opret på https://portal.azure.com)
# Lad stå tom hvis du kun bruger Google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# URL til din app (uden trailing slash)
APP_URL=http://localhost:8000

# E-mail adresser der har admin-adgang (kasserer), adskilt af komma
ADMIN_EMAILS=rasmus@eksempel.dk,anden_admin@eksempel.dk

# Sti til fil-uploads (relativ til app-mappen)
UPLOAD_DIR=uploads
